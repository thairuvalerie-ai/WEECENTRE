# Resend API Key
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Email configuration
# The email address that will send the contact form emails
FROM_EMAIL=noreply@weeecentre.com

# The email address that will receive contact form submissions
TO_EMAIL=info@weeecentre.com

# CSRF Secret
# Generate a strong random secret for CSRF protection
# You can generate one using: openssl rand -base64 32
CSRF_SECRET=your_csrf_secret_here_change_in_production

# Google reCAPTCHA
# Get your keys from https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Google Search Console Verification
# Get your verification code from https://search.google.com/search-console
# 1. Add your property (https://weeecentre.com)
# 2. Choose "HTML tag" verification method
# 3. Copy the content value from the meta tag (e.g., <meta name="google-site-verification" content="YOUR_CODE_HERE" />)
# 4. Paste only the content value below
NEXT_PUBLIC_GSC_VERIFICATION=your_google_site_verification_code_here
